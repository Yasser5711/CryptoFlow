{
  "name": "cryptoflow",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --concurrency=15",
    "build": "turbo build --filter=!prices-scraper",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "dev:prices-scraper": "turbo -F prices-scraper dev",
    "dev:analytics-prices": "turbo -F analytics-prices dev",
    "dev:viewer": "turbo -F viewer dev",
    "dev:backfill-prices": "turbo -F backfill-prices dev"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "nodemon": "^3.1.11",
    "turbo": "^2.5.4"
  },
  "packageManager": "yarn@4.9.2",
  "dependencies": {
    "cfonts": "^3.3.1",
    "chalk": "^5.6.2",
    "dotenv": "^17.2.2",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  }
}
