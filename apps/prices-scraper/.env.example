# =========================
# Core infrastructure
# =========================
# Kafka (conforme à docker-compose: PLAINTEXT_HOST://localhost:29092)
KAFKA_BROKERS=localhost:29092


# =========================
# prices-scraper (Binance WebSocket -> Kafka: prices.raw.v1)
# =========================
PRICES_TOPIC=prices.raw.v1
# PRICE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,ADAUSDT,XRPUSDT,DOGEUSDT,LINKUSDT,MATICUSDT,AVAXUSDT
PRICE_SYMBOLS=BTCUSDT
POLL_INTERVAL_MS=5000

WS_URL=wss://stream.binance.com:9443