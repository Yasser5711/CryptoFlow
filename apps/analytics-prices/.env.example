# =========================
# Core infrastructure
# =========================
# Kafka (conforme à docker-compose: PLAINTEXT_HOST://localhost:29092)
KAFKA_BROKERS=localhost:29092
METRICS_TOPIC=metrics.events

# =========================
# prices-scraper (CoinGecko -> Kafka: prices.raw.v1)
# =========================
PRICES_TOPIC=prices.raw.v1

# =========================
# analytics-prices (ticks -> OHLC1m -> Kafka: metrics.events)
# =========================
WINDOWS=1m,1h
FLUSH_INTERVAL_MS=1000
ALLOWED_SYMBOLS=BTC
DEFAULT_CURRENCY=USD


