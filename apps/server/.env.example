# =========================
# Core infrastructure
# =========================
# Kafka (conforme à docker-compose: PLAINTEXT_HOST://localhost:29092)
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=metrics-api
KAFKA_TOPIC=metrics.events
KAFKA_GROUP_ID=metrics-consumer
# InfluxDB (conforme aux DOCKER_INFLUXDB_INIT_* du compose)
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=dev-token
INFLUX_ORG=demo-org
INFLUX_BUCKET=demo-bucket

# =========================
# prices-scraper (CoinGecko -> Kafka: prices.raw.v1)
# =========================
PRICES_TOPIC=prices.raw.v1


#
# =========================
# server (API Fastify/tRPC + Kafka->Influx consumer)
# =========================
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://127.0.0.1:5176

