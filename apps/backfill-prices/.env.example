# =========================
# Core infrastructure
# =========================
# Kafka (conforme à docker-compose: PLAINTEXT_HOST://localhost:29092)
KAFKA_BROKERS=localhost:29092
METRICS_TOPIC=metrics.events
# InfluxDB (conforme aux DOCKER_INFLUXDB_INIT_* du compose)
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=dev-token
INFLUX_ORG=demo-org
INFLUX_BUCKET=demo-bucket
# =========================
# backfill-prices (Binance REST -> Kafka: metrics.events)
# =========================
BINANCE_BASE=https://api.binance.com
# BACKFILL_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BTCEUR,ETHEUR,SOLEUR
BACKFILL_SYMBOLS=BTCUSDT
BACKFILL_INTERVAL=1m
BACKFILL_LIMIT=1000
BACKFILL_SLEEP_MS=500
# - Soit nombre de jours relatifs :
BACKFILL_DAYS=7
# - Soit plage explicite (ISO UTC) :
# BACKFILL_START_ISO=2025-08-30T00:00:00Z
# BACKFILL_END_ISO=2025-09-01T00:00:00Z
BACKFILL_FIATS=USD


