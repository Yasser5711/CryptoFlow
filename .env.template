# =========================
# Core infrastructure (DEV)
# =========================
# Si Kafka tourne en Docker (docker-compose.yml expose PLAINTEXT_HOST://localhost:29092),
# et tes apps tournent sur l'hôte (node local), utilise:
KAFKA_BROKERS=localhost:29092

# Si une app tourne DANS le réseau Docker, utilise kafka:9092 pour cette app.
# (Dans ce cas, mets ce .env INSIDE le conteneur ou propose un .env spécifique pour l’app)

# InfluxDB (docker-compose publie 8086 sur l’hôte)
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=dev-token
INFLUX_ORG=demo-org
INFLUX_BUCKET=demo-bucket

# =========================
# Kafka Topics
# =========================
PRICES_TOPIC=prices.raw.v1
METRICS_TOPIC=metrics.events

# =========================
# prices-scraper
# =========================
# Binance WS→Kafka (ticks bruts)
PRICE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
POLL_INTERVAL_MS=1000
WS_URL=wss://stream.binance.com:9443

# =========================
# analytics-prices (ticks -> OHLC)
# =========================
WINDOWS=1m,5m,15m,1h
FLUSH_INTERVAL_MS=10000
ALLOWED_SYMBOLS=BTC,ETH,SOL
DEFAULT_CURRENCY=USDT

# =========================
# backfill-prices (Binance REST -> Kafka: metrics.events)
# =========================
BINANCE_BASE=https://api.binance.com
BACKFILL_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
BACKFILL_INTERVAL=1m
BACKFILL_LIMIT=1000
BACKFILL_SLEEP_MS=300
# Choisir UNE stratégie (sinon BACKFILL_DAYS par défaut)
BACKFILL_DAYS=7
# BACKFILL_START_ISO=2025-08-30T00:00:00Z
# BACKFILL_END_ISO=2025-09-01T00:00:00Z
BACKFILL_FIATS=USDT

# =========================
# server (API Fastify/tRPC + Kafka->Influx consumer)
# =========================
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
KAFKA_CLIENT_ID=metrics-api
KAFKA_TOPIC=metrics.events
KAFKA_GROUP_ID=metrics-consumer

# =========================
# viewer (front ECharts)
# =========================
VITE_API_URL=http://localhost:3000

# =========================
# Option: forcer dotenv path
# =========================
# DOTENV_CONFIG_PATH=./.env
